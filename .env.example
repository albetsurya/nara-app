NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase direct DB (for `npm run db:migrate` only, never NEXT_PUBLIC_)
SUPABASE_DB_PASSWORD=
# Google OAuth via NextAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NextAuth session secret (generate: openssl rand -base64 32). Required in production.
NEXTAUTH_SECRET=
# Optional: Pip's AI replies (server-only). Without it Pip uses gentle canned replies.
GROQ_API_KEY=
GROQ_MODEL=claude-sonnet-5-5
# Optional: Google Analytics via @next/third-parties
NEXT_PUBLIC_GA_ID=
